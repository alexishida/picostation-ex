include("${CMAKE_CURRENT_LIST_DIR}/picostation_pico1.cmake")

# The release profiles use the standard RP2040 wiring and a separate Mechacon clock.
set(GPIO_MECHACON_CLK 3)
set(PICOSTATION_SLED_STEP_US 29)
set(PICOSTATION_SCEX_BAUD 250)

if(PICOSTATION_VARIANT STREQUAL "picostationex_PU8")
    set(PICOSTATION_MECHACON_CLOCK_PERIOD 68)
elseif(PICOSTATION_VARIANT STREQUAL "picostationex_PU18")
    set(PICOSTATION_MECHACON_CLOCK_PERIOD 64)
elseif(PICOSTATION_VARIANT STREQUAL "picostationex_PU8_OC")
    set(PICOSTATION_MECHACON_CLOCK_PERIOD 42)
    set(PICOSTATION_SLED_STEP_US 15)
    set(PICOSTATION_SCEX_BAUD 404)
else()
    set(PICOSTATION_MECHACON_CLOCK_PERIOD 36)
    set(PICOSTATION_SLED_STEP_US 15)
    set(PICOSTATION_SCEX_BAUD 444)
endif()
